  "customCodeBlocks": [
    {
      "id": "aurel-styles-1",
      "location": "head",
      "title": "AUREL Scoped Styles",
      "maxChars": 45000,
      "charCount": 2160,
      "description": "Authored custom CSS variables, pseudo-elements, and keyframe rules that supplement native Webflow styles.",
      "dependencies": [],
      "code": ":root {\r\n  --bg: #0A0B0D;\r\n  --bg-soft: #111317;\r\n  --metal-dark: #23272B;\r\n  --ivory: #F0ECE5;\r\n  --silver: #C7CDD2;\r\n  --muted: #89919A;\r\n  --ice: #9DB8C9;\r\n  --rule: #374047;\r\n  --button-light: #F1EEE9;\r\n  --gutter: clamp(20px, 4.6vw, 84px);\r\n  --max-content: 1600px;\r\n\r\n  --font-display: var(--font-cormorant-garamond), 'Cormorant Garamond', Georgia, serif;\r\n  --font-sans: var(--font-manrope), 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;\r\n  --font-mono: 'IBM Plex Mono', monospace;\r\n}\r\n\r\n@layer base {\r\n  html {\r\n    background-color: var(--bg);\r\n    color: var(--ivory);\r\n    font-family: var(--font-sans);\r\n    scroll-behavior: smooth;\r\n  }\r\n\r\n  body {\r\n    background-color: var(--bg);\r\n    color: var(--ivory);\r\n    overflow-x: hidden;\r\n    margin: 0;\r\n  }\r\n}\r\n\r\n.font-display {\r\n  font-family: var(--font-display);\r\n}\r\n\r\n.font-sans-ui {\r\n  font-family: var(--font-sans);\r\n}\r\n\r\n.font-mono-tech {\r\n  font-family: var(--font-mono);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.aurel-container {\r\n  width: 100%;\r\n  max-width: var(--max-content);\r\n  margin-left: auto;\r\n  margin-right: auto;\r\n  padding-left: var(--gutter);\r\n  padding-right: var(--gutter);\r\n}\r\n\r\n/* Subtle radial studio vignette matching the approved hero reference */\r\n.hero-radial-stage {\r\n  background:\r\n    radial-gradient(circle at 50% 54%, rgba(36, 44, 54, 0.34) 0%, rgba(17, 19, 23, 0.18) 34%, rgba(10, 11, 13, 0.96) 72%, #0A0B0D 100%);\r\n}\r\n\r\n/* Restrained idle drift when motion is permitted */\r\n@keyframes aurelWatchFloat {\r\n  0%, 100% {\r\n    transform: translate3d(0, 0px, 0);\r\n  }\r\n  50% {\r\n    transform: translate3d(0, -6px, 0);\r\n  }\r\n}\r\n\r\n@keyframes aurelSlowRing {\r\n  0% {\r\n    transform: rotate(0deg);\r\n  }\r\n  100% {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n.animate-watch-float {\r\n  animation: aurelWatchFloat 7.5s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;\r\n}\r\n\r\n.animate-ring-crawl {\r\n  animation: aurelSlowRing 240s linear infinite;\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  html {\r\n    scroll-behavior: auto;\r\n  }\r\n  .animate-watch-float,\r\n  .animate-ring-crawl {\r\n    animation: none !important;\r\n    transform: none !important;\r\n  }\r\n}"
    },
    {
      "id": "aurel-runtime-1",
      "location": "footer",
      "title": "AUREL Interactive Runtime Bridge",
      "maxChars": 45000,
      "charCount": 269,
      "description": "Loads motion in page footer custom code with prefers-reduced-motion guard.",
      "dependencies": [
        "motion"
      ],
      "code": "// AUREL — Webflow Custom Code Runtime Bridge\n// Dependencies: motion\nconst prefersReducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\nif (!prefersReducedMotion) {\n  // Attach interactive stage controllers to [data-webflow-embed] containers\n}"
    }
  ]

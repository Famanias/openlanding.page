    {
      "id": "zeno-styles-1",
      "location": "head",
      "title": "ZENO. Scoped Styles",
      "maxChars": 45000,
      "charCount": 3715,
      "description": "Authored custom CSS variables, pseudo-elements, and keyframe rules that supplement native Webflow styles.",
      "dependencies": [],
      "code": "@custom-variant dark (&:where(.dark, .dark *));\r\n\r\n:root {\r\n  --bg: #111117;\r\n  --bg-soft: #17171e;\r\n  --ivory: #F2F0EB;\r\n  --violet: #A58AFF;\r\n  --cobalt: #5367F9;\r\n  --lilac: #D8CFF2;\r\n  --muted: #96939F;\r\n  --line: rgba(242, 240, 235, 0.20);\r\n  --line-strong: rgba(242, 240, 235, 0.38);\r\n  --section-pad-x: clamp(22px, 3vw, 58px);\r\n  --header-h: clamp(68px, 7vw, 104px);\r\n  --ease-editorial: cubic-bezier(0.22, 1, 0.36, 1);\r\n\r\n  --font-display: var(--font-cormorant-garamond), 'Cormorant Garamond', var(--font-bodoni-moda), 'Bodoni Moda', Georgia, serif;\r\n  --font-sans: var(--font-dm-sans), 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;\r\n}\r\n\r\n* {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml {\r\n  background-color: var(--bg);\r\n  color: var(--ivory);\r\n  font-family: var(--font-sans);\r\n  scroll-behavior: smooth;\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  html {\r\n    scroll-behavior: auto;\r\n  }\r\n}\r\n\r\nbody {\r\n  background-color: var(--bg);\r\n  color: var(--ivory);\r\n  margin: 0;\r\n  padding: 0;\r\n  overflow-x: hidden;\r\n  position: relative;\r\n}\r\n\r\n/* Continuous subtle editorial print grain overlay across all sections */\r\nbody::before {\r\n  content: \"\";\r\n  position: fixed;\r\n  inset: 0;\r\n  pointer-events: none;\r\n  z-index: 45;\r\n  opacity: 0.032;\r\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\r\n}\r\n\r\n/* Editorial Display Typography */\r\n.font-editorial {\r\n  font-family: var(--font-display);\r\n  font-feature-settings: \"liga\" 1, \"kern\" 1;\r\n}\r\n\r\n.font-grotesk {\r\n  font-family: var(--font-sans);\r\n}\r\n\r\n/* Oversized statement scale matching 16:9 references */\r\n.zeno-display-hero {\r\n  font-family: var(--font-display);\r\n  font-size: clamp(3.3rem, 7.1vw, 8.2rem);\r\n  line-height: 0.89;\r\n  letter-spacing: -0.022em;\r\n  font-weight: 600;\r\n}\r\n\r\n.zeno-display-section {\r\n  font-family: var(--font-display);\r\n  font-size: clamp(3.1rem, 6.6vw, 7.6rem);\r\n  line-height: 0.90;\r\n  letter-spacing: -0.022em;\r\n  font-weight: 600;\r\n}\r\n\r\n.zeno-display-work {\r\n  font-family: var(--font-display);\r\n  font-size: clamp(2.85rem, 6.0vw, 6.9rem);\r\n  line-height: 0.91;\r\n  letter-spacing: -0.02em;\r\n  font-weight: 600;\r\n}\r\n\r\n/* Expressive Violet Italic Accent with subtle registration echo */\r\n.zeno-accent-italic {\r\n  font-family: var(--font-display);\r\n  font-style: italic;\r\n  font-weight: 600;\r\n  color: var(--violet);\r\n  letter-spacing: -0.01em;\r\n  text-shadow: 3px 2px 0px rgba(165, 138, 255, 0.2), -1.5px -1px 0px rgba(83, 103, 249, 0.18);\r\n}\r\n\r\n/* Transparent Cutout Contour Shadows & 3D Depth Layering */\r\n.cutout-shadow-hero {\r\n  filter: drop-shadow(0 28px 52px rgba(0, 0, 0, 0.78))\r\n          drop-shadow(0 6px 18px rgba(83, 103, 249, 0.16));\r\n  will-change: transform;\r\n}\r\n\r\n.cutout-shadow-card {\r\n  filter: drop-shadow(0 18px 34px rgba(0, 0, 0, 0.76))\r\n          drop-shadow(0 4px 10px rgba(0, 0, 0, 0.55));\r\n  will-change: transform;\r\n}\r\n\r\n.cutout-shadow-card-active {\r\n  filter: drop-shadow(0 24px 44px rgba(0, 0, 0, 0.86))\r\n          drop-shadow(0 0 26px rgba(165, 138, 255, 0.22));\r\n  will-change: transform;\r\n}\r\n\r\n.cutout-shadow-world {\r\n  filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.22));\r\n  will-change: transform;\r\n}\r\n\r\n.perspective-stage {\r\n  perspective: 1200px;\r\n}\r\n\r\n/* Focus accessibility ring */\r\n.zeno-focus:focus-visible {\r\n  outline: 2px solid var(--violet);\r\n  outline-offset: 4px;\r\n}\r\n\r\n/* Vertical archive micro-labels */\r\n.writing-vertical {\r\n  writing-mode: vertical-rl;\r\n  text-orientation: mixed;\r\n}"
    },

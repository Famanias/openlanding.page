{
  "slug": "zeno",
  "title": "ZENO.",
  "industry": "Digital Experience & Technology",
  "description": "ZENO is an independent creative practice building identities, campaigns, and digital experiences for brands ready to challenge convention.",
  "stack": "Next.js 16 · React 19 · Motion · Tailwind v4",
  "liveUrl": "https://www.openlanding.page/templates/zeno",
  "downloadUrl": "https://www.openlanding.page/downloads/zeno.html",
  "manifestUrl": "https://www.openlanding.page/copy/zeno-webflow.json",
  "webflowPromptUrl": "https://www.openlanding.page/copy/zeno-webflow-prompt.md",
  "variables": {
    "collectionName": "ZENO. Tokens",
    "colors": [
      {
        "name": "Color / Bg",
        "cssVar": "--bg",
        "value": "#111117",
        "isCustomExpression": false
      },
      {
        "name": "Color / Bg Soft",
        "cssVar": "--bg-soft",
        "value": "#17171e",
        "isCustomExpression": false
      },
      {
        "name": "Color / Ivory",
        "cssVar": "--ivory",
        "value": "#F2F0EB",
        "isCustomExpression": false
      },
      {
        "name": "Color / Violet",
        "cssVar": "--violet",
        "value": "#A58AFF",
        "isCustomExpression": false
      },
      {
        "name": "Color / Cobalt",
        "cssVar": "--cobalt",
        "value": "#5367F9",
        "isCustomExpression": false
      },
      {
        "name": "Color / Lilac",
        "cssVar": "--lilac",
        "value": "#D8CFF2",
        "isCustomExpression": false
      },
      {
        "name": "Color / Muted",
        "cssVar": "--muted",
        "value": "#96939F",
        "isCustomExpression": false
      },
      {
        "name": "Color / Line",
        "cssVar": "--line",
        "value": "rgba(242, 240, 235, 0.20)",
        "isCustomExpression": false
      },
      {
        "name": "Color / Line Strong",
        "cssVar": "--line-strong",
        "value": "rgba(242, 240, 235, 0.38)",
        "isCustomExpression": false
      }
    ],
    "fonts": [
      {
        "name": "Font / Display",
        "cssVar": "--font-display",
        "family": "Cormorant Garamond",
        "fallback": "Cormorant Garamond, var(--font-bodoni-moda), Bodoni Moda, Georgia, serif",
        "googleFont": "Cormorant Garamond"
      },
      {
        "name": "Font / Sans",
        "cssVar": "--font-sans",
        "family": "DM Sans",
        "fallback": "DM Sans, -apple-system, BlinkMacSystemFont, sans-serif",
        "googleFont": "DM Sans"
      },
      {
        "name": "Font / Bodoni Moda",
        "cssVar": "--font-bodoni-moda",
        "family": "Bodoni Moda",
        "fallback": "system-ui, sans-serif",
        "googleFont": "Bodoni Moda"
      },
      {
        "name": "Font / Playfair Display",
        "cssVar": "--font-playfair-display",
        "family": "Playfair Display",
        "fallback": "system-ui, sans-serif",
        "googleFont": "Playfair Display"
      }
    ],
    "sizes": [
      {
        "name": "Size / Section Pad X",
        "cssVar": "--section-pad-x",
        "value": "clamp(22px, 3vw, 58px)",
        "isCustomExpression": true
      },
      {
        "name": "Size / Header H",
        "cssVar": "--header-h",
        "value": "clamp(68px, 7vw, 104px)",
        "isCustomExpression": true
      }
    ]
  },

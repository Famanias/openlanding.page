  "sections": [
    {
      "id": "section-1",
      "index": 1,
      "title": "Make the physical object matter",
      "summary": "The actual PO-33 must be recognizable and technically accurate.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-2",
      "index": 2,
      "title": "Motion expresses sound editing",
      "summary": "Capture → isolate → repeat → transform → release.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-3",
      "index": 3,
      "title": "Every scene has a narrative purpose",
      "summary": "No motion exclusively to show off an animation library.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-4",
      "index": 4,
      "title": "One continuous publication",
      "summary": "The page should feel like exploring a single long experimental music zine, not seven unrelated backgrounds.",
      "deliveryMode": "native-whtml",
      "cssSelectors": [
        ".nc-halftone-strip",
        ".nc-paper-halftone"
      ]
    },
    {
      "id": "section-5",
      "index": 5,
      "title": "Silent by default",
      "summary": "Never autoplay audible sound or automatically request microphone access.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-6",
      "index": 6,
      "title": "Interactions are real",
      "summary": "Tabs, effects, buttons, playback, and sequence edits must affect actual state.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-7",
      "index": 7,
      "title": "Desktop can be cinematic; mobile must remain usable",
      "summary": "Maintain story coherence with reduced complexity.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-8",
      "index": 8,
      "title": "Accessible without motion",
      "summary": "Information and actions remain available with reduced motion, keyboard input, touch, and without audio.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    }
  ],
  "customCodeBlocks": [
    {
      "id": "noiseclub-styles-1",
      "location": "head",
      "title": "NOISE CLUB Scoped Styles",
      "maxChars": 45000,
      "charCount": 3201,
      "description": "Authored custom CSS variables, pseudo-elements, and keyframe rules that supplement native Webflow styles.",
      "dependencies": [],
      "code": "@theme {\n  --color-nc-ink: #111313;\n  --color-nc-paper: #F1EEE5;\n  --color-nc-acid: #CBFF49;\n  --color-nc-red: #FF6748;\n\n  --ease-nc-out: cubic-bezier(0.16, 1, 0.3, 1);\n  --ease-nc-travel: cubic-bezier(0.77, 0, 0.175, 1);\n  --ease-nc-feedback: cubic-bezier(0.23, 1, 0.32, 1);\n\n  --dur-nc-press: 120ms;\n  --dur-nc-hover: 260ms;\n  --dur-nc-state: 420ms;\n  --dur-nc-reveal: 850ms;\n  --dur-nc-scene: 1100ms;\n\n  --font-display: var(--font-anton), Impact, 'Arial Narrow', sans-serif;\n  --font-sans: var(--font-public-sans), -apple-system, BlinkMacSystemFont, sans-serif;\n  --font-mono: var(--font-ibm-plex-mono), ui-monospace, SFMono-Regular, monospace;\n}\n\n:root {\n  --nc-ink-black: #111313;\n  --nc-paper-bone: #F1EEE5;\n  --nc-signal-acid: #CBFF49;\n  --nc-record-red: #FF6748;\n\n  --nc-ease-out: cubic-bezier(0.16, 1, 0.3, 1);\n  --nc-ease-travel: cubic-bezier(0.77, 0, 0.175, 1);\n  --nc-ease-feedback: cubic-bezier(0.23, 1, 0.32, 1);\n\n  --nc-duration-press: 120ms;\n  --nc-duration-hover: 260ms;\n  --nc-duration-state: 420ms;\n  --nc-duration-reveal: 850ms;\n  --nc-duration-scene: 1100ms;\n\n  --font-display: var(--font-anton), Impact, 'Arial Narrow', sans-serif;\n  --font-sans: var(--font-public-sans), -apple-system, BlinkMacSystemFont, sans-serif;\n  --font-mono: var(--font-ibm-plex-mono), ui-monospace, SFMono-Regular, monospace;\n}\n\n.nc-body {\n  background-color: #111313;\n  color: #F1EEE5;\n  font-family: var(--font-sans);\n  letter-spacing: 0.01em;\n  margin: 0;\n  overflow-x: hidden;\n}\n\n.font-display {\n  font-family: var(--font-display);\n  letter-spacing: -0.01em;\n  line-height: 0.94;\n  text-transform: uppercase;\n}\n\n.font-sans-body {\n  font-family: var(--font-sans);\n}\n\n.font-mono-meta {\n  font-family: var(--font-mono);\n  font-variant-numeric: tabular-nums;\n}\n\n/* Tactile print grain & subtle halftone surface without repaint jank */\n.nc-print-grain {\n  background-image: radial-gradient(rgba(241, 238, 229, 0.055) 1px, transparent 0);\n  background-size: 24px 24px;\n}\n\n.nc-halftone-strip {\n  background-image: radial-gradient(rgba(203, 255, 73, 0.18) 1px, transparent 0);\n  background-size: 6px 6px;\n}\n\n.nc-paper-halftone {\n  background-image: radial-gradient(rgba(17, 19, 19, 0.12) 1px, transparent 0);\n  background-size: 8px 8px;\n}\n\n/* Editorial irregular cut mask */\n.nc-cut-corner {\n  clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));\n}\n\n/* Button tactile feedback */\n.nc-btn-interactive {\n  transition: transform var(--nc-duration-press) var(--nc-ease-feedback),\n              background-color var(--nc-duration-hover) var(--nc-ease-out),\n              color var(--nc-duration-hover) var(--nc-ease-out),\n              border-color var(--nc-duration-hover) var(--nc-ease-out);\n}\n\n.nc-btn-interactive:active {\n  transform: scale(0.97);\n}\n\n/* Accessible focus ring matching NOISE CLUB Signal Acid */\n:focus-visible {\n  outline: 2px solid #CBFF49;\n  outline-offset: 3px;\n}\n\n/* Respect reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}"
    },
    {
      "id": "noiseclub-runtime-1",
      "location": "footer",
      "title": "NOISE CLUB Interactive Runtime Bridge",
      "maxChars": 45000,
      "charCount": 419,
      "description": "Loads gsap, lenis in page footer custom code with prefers-reduced-motion guard.",
      "dependencies": [
        "gsap",
        "lenis"
      ],
      "code": "// NOISE CLUB — Webflow Custom Code Runtime Bridge\n// Dependencies: gsap, lenis\nimport Lenis from \"https://cdn.jsdelivr.net/npm/lenis@1.3.27/+esm\";\nimport gsap from \"https://cdn.jsdelivr.net/npm/gsap@3.15.0/+esm\";\nconst prefersReducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\nif (!prefersReducedMotion) {\n  const lenis = new Lenis({ autoRaf: true });\n  window.__openlandingLenis = lenis;\n}"
    }
  ]
}

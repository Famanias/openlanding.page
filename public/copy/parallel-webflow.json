  "sections": [
    {
      "id": "section-1",
      "index": 1,
      "title": "Header & Telemetry HUD",
      "summary": "Minimal sticky navigation with PARALLEL wordmark, system status indicator, mode shortcuts, anchor navigation, and primary \"Request Simulation\" CTA.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-2",
      "index": 2,
      "title": "Hero Simulation Stage (The 3D Digital Twin)",
      "summary": "Full-bleed procedural Three.js architectural model with 6 operational chapters:",
      "deliveryMode": "hybrid-embed",
      "cssSelectors": [],
      "customCodeReason": "Contains interactive 3D/WebGL, procedural canvas, or pinned scroll-scrubbed stage requiring an HtmlEmbed + page footer script."
    },
    {
      "id": "section-3",
      "index": 3,
      "title": "Interactive 2.5D Workflow Twin Canvas",
      "summary": "Synchronized stage demonstrating automated graph re-weighting, dynamic corridor diversion, and real-time impedance optimization.",
      "deliveryMode": "hybrid-embed",
      "cssSelectors": [],
      "customCodeReason": "Contains interactive 3D/WebGL, procedural canvas, or pinned scroll-scrubbed stage requiring an HtmlEmbed + page footer script."
    },
    {
      "id": "section-4",
      "index": 4,
      "title": "Side-by-Side Reality Comparison",
      "summary": "Build the upstream 2.5D SVG city exhibit with six districts, three bridges, and paired baseline/intervention views. Share a deterministic 07:00–10:00 timeline with a 07:30 Central Bridge closure, defaulting to 08:45. Include play/pause, timeline scrubbing, time checkpoints, Dynamic Rerouting, Transit Capacity Surge, Freight Window Slotting, split/merge, split replay, crossing focus, reset, paired entity inspection, and mobile stacked/Future A/Future B views. Keep Future A invariant when interventions change; close the Central Bridge in both futures after 07:30. Show the synthetic-data disclosure. Render this exhibit with SVG and reuse cached simulation states. Cap replay at 24 fps, pause offscreen or when the page is hidden, and show the completed replay immediately for reduced motion.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-5",
      "index": 5,
      "title": "Causal Reasoning & Explainability Ledger",
      "summary": "Step-through inspection cards detailing why decisions are recommended, with confidence intervals and graph path evidence.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-6",
      "index": 6,
      "title": "Proof of Impact & Performance Metrics",
      "summary": "Quantitative benchmarks (reduction in congestion spillovers, cross-river flow preservation, delivery time savings).",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-7",
      "index": 7,
      "title": "Simulation Intake Form",
      "summary": "Interactive client-side validated intake module with scenario parameter selection and submission confirmation.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    },
    {
      "id": "section-8",
      "index": 8,
      "title": "Footer & Technical Specs",
      "summary": "Architecture specifications, platform requirements, model versioning telemetry, and full sitemap links.",
      "deliveryMode": "native-whtml",
      "cssSelectors": []
    }
  ],
  "customCodeBlocks": [
    {
      "id": "parallel-styles-1",
      "location": "head",
      "title": "PARALLEL Scoped Styles",
      "maxChars": 45000,
      "charCount": 1800,
      "description": "Authored custom CSS variables, pseudo-elements, and keyframe rules that supplement native Webflow styles.",
      "dependencies": [],
      "code": "@custom-variant dark (&:where(.dark, .dark *));\n\n@layer base {\n  :root {\n    --font-display: var(--font-display, 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif);\n    --font-sans: var(--font-sans, 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif);\n    --font-mono: var(--font-mono, 'IBM Plex Mono', monospace);\n  }\n\n  html {\n    font-family: var(--font-sans);\n    background-color: #101315;\n    color: #F6F5F1;\n    scroll-behavior: auto;\n  }\n\n  h1, h2, h3, h4, .font-display {\n    font-family: var(--font-display);\n  }\n\n  .font-mono {\n    font-family: var(--font-mono);\n    font-variant-numeric: tabular-nums;\n  }\n}\n\n/* Custom Range Input Styling for Simulation Controls */\ninput[type=\"range\"].par-slider,\ninput[type=\"range\"].parallel-slider {\n  -webkit-appearance: none;\n  appearance: none;\n  background: rgba(246, 245, 241, 0.16);\n  height: 4px;\n  border-radius: 2px;\n}\n\ninput[type=\"range\"].par-slider::-webkit-slider-thumb,\ninput[type=\"range\"].parallel-slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  appearance: none;\n  width: 14px;\n  height: 14px;\n  border-radius: 2px;\n  background: #E85D36;\n  cursor: pointer;\n  border: 1px solid #F6F5F1;\n  transition: transform 150ms cubic-bezier(0.16, 1, 0.3, 1);\n}\n\ninput[type=\"range\"].par-slider::-webkit-slider-thumb:hover,\ninput[type=\"range\"].parallel-slider::-webkit-slider-thumb:hover {\n  transform: scale(1.15);\n}\n\ninput[type=\"range\"].par-slider:focus-visible,\ninput[type=\"range\"].parallel-slider:focus-visible {\n  outline: 2px solid #E85D36;\n  outline-offset: 4px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, ::before, ::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}"
    },
    {
      "id": "parallel-runtime-1",
      "location": "footer",
      "title": "PARALLEL Interactive Runtime Bridge",
      "maxChars": 45000,
      "charCount": 498,
      "description": "Loads three, gsap, lenis in page footer custom code with prefers-reduced-motion guard.",
      "dependencies": [
        "three",
        "gsap",
        "lenis"
      ],
      "code": "// PARALLEL — Webflow Custom Code Runtime Bridge\n// Dependencies: three, gsap, lenis\nimport Lenis from \"https://cdn.jsdelivr.net/npm/lenis@1.3.27/+esm\";\nimport gsap from \"https://cdn.jsdelivr.net/npm/gsap@3.15.0/+esm\";\nimport * as THREE from \"https://cdn.jsdelivr.net/npm/three@0.186.1/+esm\";\nconst prefersReducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\nif (!prefersReducedMotion) {\n  const lenis = new Lenis({ autoRaf: true });\n  window.__openlandingLenis = lenis;\n}"
    }
  ]
}

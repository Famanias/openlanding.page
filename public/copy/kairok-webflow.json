  "sections": [
    {
      "id": "section-1",
      "index": 1,
      "title": "Main Landing Page",
      "summary": "See beyond the expected. An interactive cinematic product experience and optical exploration for the fictional KAIRO K-01 mirrorless camera concept.",
      "deliveryMode": "native-whtml",
      "cssSelectors": [
        ".css",
        ".kairo-story-track",
        ".kairo-story-sticky",
        ".kairo-cover-stage",

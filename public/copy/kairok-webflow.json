  "customCodeBlocks": [
    {
      "id": "kairok-styles-1",
      "location": "head",
      "title": "KAIRO K Scoped Styles",
      "maxChars": 45000,
      "charCount": 5412,
      "description": "Authored custom CSS variables, pseudo-elements, and keyframe rules that supplement native Webflow styles.",
      "dependencies": [],
      "code": ".kairo-story-track {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 580vh;\r\n  background-color: var(--black-carbon);\r\n}\r\n\r\n@media (max-width: 1024px) {\r\n  .kairo-story-track {\r\n    height: 480vh;\r\n  }\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .kairo-story-track {\r\n    height: 410vh;\r\n  }\r\n}\r\n\r\n.kairo-story-sticky {\r\n  position: sticky;\r\n  top: 0;\r\n  width: 100%;\r\n  height: 100svh;\r\n  min-height: 560px;\r\n  overflow: hidden;\r\n  background-color: var(--black-carbon);\r\n}\r\n\r\n/* Shared 16:9 cover coordinate box for city hotspots so markers stay locked to subject features on any aspect ratio */\r\n.kairo-cover-stage {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  width: max(100vw, 177.78svh);\r\n  height: max(100svh, 56.25vw);\r\n  pointer-events: none;\r\n}\r\n\r\n/* Optical copper ring specular sweep on load */\r\n@keyframes kairoLensGlint {\r\n  0% {\r\n    opacity: 0;\r\n    transform: rotate(-35deg) scale(0.98);\r\n  }\r\n  35% {\r\n    opacity: 0.55;\r\n  }\r\n  100% {\r\n    opacity: 0;\r\n    transform: rotate(25deg) scale(1.01);\r\n  }\r\n}\r\n\r\n.kairo-lens-glint {\r\n  animation: kairoLensGlint 2.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s 1 forwards;\r\n}\r\n\r\n/* Viewfinder reticle corner brackets */\r\n.kairo-reticle-corner {\r\n  position: absolute;\r\n  width: 14px;\r\n  height: 14px;\r\n  border-color: rgba(230, 143, 99, 0.65);\r\n  pointer-events: none;\r\n}\n\n:root {\r\n  --black-carbon: #121315;\r\n  --graphite: #1d2024;\r\n  --titanium: #7f858d;\r\n  --porcelain: #f2efe9;\r\n  --copper: #e68f63;\r\n  --copper-soft: #b8785d;\r\n  --stone: #d2cec7;\r\n  --body-muted: #a8aaa9;\r\n  --panel-line: rgba(242, 239, 233, 0.15);\r\n  --panel-line-dark: rgba(18, 19, 21, 0.12);\r\n\r\n  --font-display: 'Bricolage Grotesque', -apple-system, BlinkMacSystemFont, sans-serif;\r\n  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;\r\n  --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, monospace;\r\n}\r\n\r\n*,\r\n*::before,\r\n*::after {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml {\r\n  background-color: var(--black-carbon);\r\n  color: var(--porcelain);\r\n  font-family: var(--font-sans);\r\n  scroll-behavior: smooth;\r\n  overflow-x: clip;\r\n}\r\n\r\nbody {\r\n  margin: 0;\r\n  padding: 0;\r\n  background-color: var(--black-carbon);\r\n  color: var(--porcelain);\r\n  font-family: var(--font-sans);\r\n  overflow-x: clip;\r\n  min-height: 100%;\r\n  text-rendering: optimizeLegibility;\r\n}\r\n\r\n.font-display-kairo {\r\n  font-family: var(--font-display);\r\n}\r\n\r\n.font-sans-kairo {\r\n  font-family: var(--font-sans);\r\n}\r\n\r\n.font-mono-kairo {\r\n  font-family: var(--font-mono);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n/* Intentional keyboard focus ring */\r\n:focus-visible {\r\n  outline: 2px solid var(--copper);\r\n  outline-offset: 3px;\r\n}\r\n\r\n/* Button edge copper line response */\r\n.kairo-btn-primary {\r\n  position: relative;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 0.625rem;\r\n  padding: 0.75rem 1.375rem;\r\n  background-color: var(--porcelain);\r\n  color: var(--black-carbon);\r\n  font-family: var(--font-sans);\r\n  font-size: 0.8125rem;\r\n  font-weight: 600;\r\n  letter-spacing: 0.02em;\r\n  border: 1px solid rgba(242, 239, 233, 0.9);\r\n  border-radius: 2px;\r\n  transition:\r\n    background-color 180ms cubic-bezier(0.16, 1, 0.3, 1),\r\n    border-color 180ms cubic-bezier(0.16, 1, 0.3, 1),\r\n    color 180ms cubic-bezier(0.16, 1, 0.3, 1),\r\n    transform 180ms cubic-bezier(0.16, 1, 0.3, 1);\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n}\r\n\r\n.kairo-btn-primary:hover {\r\n  background-color: var(--copper);\r\n  border-color: var(--copper);\r\n  color: var(--black-carbon);\r\n}\r\n\r\n.kairo-btn-secondary {\r\n  position: relative;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 0.625rem;\r\n  padding: 0.75rem 1.375rem;\r\n  background-color: rgba(18, 19, 21, 0.55);\r\n  color: var(--porcelain);\r\n  font-family: var(--font-sans);\r\n  font-size: 0.8125rem;\r\n  font-weight: 500;\r\n  letter-spacing: 0.02em;\r\n  border: 1px solid rgba(242, 239, 233, 0.24);\r\n  border-radius: 2px;\r\n  backdrop-filter: blur(8px);\r\n  transition:\r\n    border-color 180ms cubic-bezier(0.16, 1, 0.3, 1),\r\n    background-color 180ms cubic-bezier(0.16, 1, 0.3, 1),\r\n    color 180ms cubic-bezier(0.16, 1, 0.3, 1);\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n}\r\n\r\n.kairo-btn-secondary:hover {\r\n  border-color: var(--copper);\r\n  background-color: rgba(230, 143, 99, 0.12);\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  html {\r\n    scroll-behavior: auto;\r\n  }\r\n  *,\r\n  *::before,\r\n  *::after {\r\n    animation-duration: 0.01ms !important;\r\n    animation-iteration-count: 1 !important;\r\n    transition-duration: 0.01ms !important;\r\n  }\r\n}\n\n/* Optical handoff mask and editorial chapter surfaces */\r\n.kairo-porcelain-chapter {\r\n  background-color: var(--porcelain);\r\n  color: var(--black-carbon);\r\n}\r\n\r\n.kairo-stone-chapter {\r\n  background-color: var(--stone);\r\n  color: var(--black-carbon);\r\n}\r\n\r\n.kairo-carbon-chapter {\r\n  background-color: var(--black-carbon);\r\n  color: var(--porcelain);\r\n}\r\n\r\n.kairo-hairline-top {\r\n  border-top: 1px solid var(--panel-line);\r\n}\r\n\r\n.kairo-hairline-dark-top {\r\n  border-top: 1px solid var(--panel-line-dark);\r\n}\r\n\r\n/* Smooth image pan for exploded camera and collection trio */\r\n.kairo-pan-surface {\r\n  transition:\r\n    transform 520ms cubic-bezier(0.16, 1, 0.3, 1),\r\n    object-position 520ms cubic-bezier(0.16, 1, 0.3, 1),\r\n    filter 320ms cubic-bezier(0.16, 1, 0.3, 1);\r\n}"

{
  "name": "openlandingpage",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "predev": "tsx scripts/generate-copy-bundles.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/generate-copy-bundles.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsx scripts/check-isolation.ts && tsx scripts/check-palette.ts && tsx scripts/check-media.ts",
    "archive": "tsx scripts/archive-templates.ts",
    "images": "tsx scripts/process-images.ts",
    "clips": "tsx scripts/process-clips.ts",
    "videos": "tsx scripts/process-clips.ts",
    "preview": "tsx scripts/capture-gallery-previews.ts",
    "clips:record": "tsx scripts/capture-gallery-clips.ts",
    "media:truecut": "npm run images -- truecut && npm run clips -- truecut",
    "process-images": "tsx scripts/process-images.ts",
    "process-clips": "tsx scripts/process-clips.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "motion": "^14.4.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "tone": "^15.1.22",
    "troika-three-text": "^0.52.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fast-glob": "^3.3.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
